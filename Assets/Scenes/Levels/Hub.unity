  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EternalSleep.Dream.DreamerNPC
  dreamerId: Aldeano_3
  displayName: Hermana Ilse
  dreamScene: 
  sleepingLines:
  - ...las velas se apagan una a una... y nadie reza...
  - La catedral... respira... la oigo respirar...
  - "(Murmura una oraci\xF3n que nunca termina.)"
  awakeLines:
  - "Las velas volvieron a encenderse. Lo vi en el sue\xF1o."
  - "Que la luz gu\xEDe tu m\xE1scara, caballero."
  enterChoice: "Entrar en su sue\xF1o"
  leaveChoice: Dejarlo descansar
