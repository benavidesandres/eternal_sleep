--- !u!114 &970777975
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 970777973}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a3c062ccb14df004da4b5c16db4da767, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EternalSleep.Village.TalkingNPC
  npcId: npc_grim
  displayName: Grim, el mercader
  lines:
  - "\xBFComprar? No, no... ya no vendo nada. Las monedas no sirven en los sue\xF1os."
  - "Pero colecciono cosas brillantes. Tr\xE1eme todas las L\xE1grimas de Luna del pueblo y te contar\xE9 un secreto."
  secretAfterTalks: 0
  secretLines: []
  rewardLines:
  - "\xA1Todas las L\xE1grimas! Brillan como el primer d\xEDa..."
  - "Un trato es un trato: antes de ti hubo otro caballero con m\xE1scara. Entr\xF3 en el sue\xF1o eterno y nunca volvi\xF3."
  - "Su estatua est\xE1 a la entrada del pueblo. Quiz\xE1s, en alg\xFAn lugar, \xE9l tambi\xE9n te est\xE1 so\xF1ando."
  prompt: {fileID: 1621383461}
  body: {fileID: 970777978}
  facePlayer: 1
