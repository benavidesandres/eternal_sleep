  dreamerId: Aldeano_4
  displayName: Tobi
  dreamScene: 
  sleepingLines:
  - "...mam\xE1... la polilla grande est\xE1 en la ventana..."
  - "No quiero jugar m\xE1s a las escondidas... me est\xE1n buscando..."
  - "(Se abraza a un mu\xF1eco de trapo.)"
  awakeLines:
  - "\xA1Kael! \xA1Le pegaste a la polilla gigante! \xBFVerdad que s\xED?"
  - Ya no me escondo debajo de la cama.
  enterChoice: "Entrar en su sue\xF1o"
  leaveChoice: Dejarlo descansar
  body: {fileID: 450064121}
