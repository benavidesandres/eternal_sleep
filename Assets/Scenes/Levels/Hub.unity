  m_EditorClassIdentifier: Assembly-CSharp::EternalSleep.Village.TalkingNPC
  npcId: npc_lune
  displayName: Lune
  lines:
  - "\xA1Mira! Atrap\xE9 una polilla de luz. Es de las buenas, no muerde."
  - "Mi hermano Tobi est\xE1 dormido y no despierta... \xBFT\xFA puedes ayudarlo?"
  - "Cuando sea grande quiero ser caballera. Con m\xE1scara y todo."
  secretAfterTalks: 0
  secretLines: []
  rewardLines: []
  prompt: {fileID: 1258628132}
  body: {fileID: 2099792379}
  facePlayer: 1
